Options -Indexes
DirectoryIndex index.php
RedirectMatch 403 (?i)/(\.git|\.svn|includes|tests|tools|mcd|backups|exports|vendor|node_modules)(/|$)

# Les scripts et documents internes ne sont pas des ressources publiques.
<FilesMatch "(?i)(^\.|\.(sql|md|log|bak|backup|ini|env|json)$|^config.*\.php$)">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
